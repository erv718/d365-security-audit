# Copy this file to ".env" and fill it in. NEVER commit your real .env.
#
# --- Authentication (pick ONE approach) ---
#
# Option A: a read-only app registration (good for automation / scheduled runs).
#   Fill in all three. Least-privilege permissions are listed in docs/permissions.md.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
#
# Option B: run as yourself. Leave CLIENT_ID / CLIENT_SECRET blank and run `az login` first.
#   The scripts fall back to the Azure CLI token for whoever is signed in.
#
# --- Scope ---
#
# Dataverse environments to audit (comma-separated URLs). Leave blank to skip Dataverse.
DATAVERSE_ENVIRONMENTS=https://yourorg.crm.dynamics.com
#
# Azure subscriptions to audit (comma-separated IDs). Leave blank to audit every
# subscription your identity can read.
AZURE_SUBSCRIPTIONS=
